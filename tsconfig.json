{
  "include": [
    "web/src/**/*",
    "shared/**/*",
    "tools/**/*",
    "tests/**/*",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./web/src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    }
  }
}
